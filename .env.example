# Server
PORT=4010
NODE_ENV=production
PUBLIC_URL=https://www.gmmarmi.com

# Database. Leave empty for local development: an embedded Postgres (PGlite) is stored in ./data
DATABASE_URL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@gmmarmi.com
ADMIN_PASSWORD=ChangeMe123!
# Staff account (Enquiries, Live chat and My account only), created once on first start
STAFF_EMAIL=staff@gmmarmi.local
STAFF_PASSWORD=GmStaff2026!

# Email (SMTP). If SMTP_HOST is empty, emails are only logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GM Andreou Marmi <no-reply@gmmarmi.com>"
NOTIFY_EMAIL=gmarmi@cytanet.com.cy
